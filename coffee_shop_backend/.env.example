DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSLMODE=verify-full
# Optional CA bundle path when the database provider does not use a trusted system CA.
DATABASE_SSLROOTCERT=
FRONTEND_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
TURNSTILE_REQUIRED=True
TURNSTILE_SECRET_KEY=replace-with-cloudflare-secret-key
TURNSTILE_ALLOWED_HOSTNAMES=example.com
MEDIA_ROOT=/var/lib/buffiecoffee/media
# Set True only when frontend and API are on different registrable domains.
CROSS_SITE_SESSION_COOKIES=False
